# Keep this file on the server only; chmod 600 .env.
HA_TOKEN=
# Independent random token shared with the display client (24+ characters).
DISPLAY_TOKEN=

# Optional. Leave KEY empty to disable backend generation; the display still reads the HA text helper.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
